#!/bin/sh
# Lean pre-commit per the mechanical-enforcement position: encode the rules
# the protocol already states. Enable once: git config core.hooksPath .githooks
fail=0
for f in docs/questions/*.md; do
  [ "$(grep -c '^title:\|^status:\|^updated:' "$f")" = 3 ] || { echo "pre-commit: bad frontmatter (need exactly title/status/updated): $f"; fail=1; }
  grep -qE '^## What would change my mind[[:space:]]*$' "$f" || { echo "pre-commit: missing falsifier section: $f"; fail=1; }
  # Positions only: an open question has no position, so nothing to enforce.
  if grep -q '^status: working-answer' "$f"; then
    grep -qE '^## How to enforce this[[:space:]]*$' "$f" || { echo "pre-commit: missing enforcement section: $f"; fail=1; }
  fi
done
# verify-deploy.sh runs only after a push to main, so a syntax error in it
# reaches CI unreviewed — one did. Parsing costs nothing and catches it here.
for f in scripts/*.sh .githooks/pre-commit .githooks/commit-msg; do
  [ -f "$f" ] || continue
  sh -n "$f" 2>/dev/null || { echo "pre-commit: shell syntax error in $f"; fail=1; }
done

if command -v lychee >/dev/null 2>&1; then
  lychee --config lychee.toml --offline --no-progress . >/dev/null 2>&1 || { echo "pre-commit: lychee --offline failed (broken internal link or anchor)"; fail=1; }
else
  echo "pre-commit note: lychee not installed; internal-link check deferred to CI"
fi
exit $fail
