---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const protocol = await getEntry('singles', 'docs/protocol');
if (!protocol) throw new Error('protocol singleton missing');
const { Content } = await render(protocol);
const base = import.meta.env.BASE_URL;
---

<Base
  title="Research Protocol"
  description="The five rules governing how this content is researched and maintained."
  mdHref={`${base}/protocol.md`}
>
  <Content />
</Base>
