---
import { getCollection } from 'astro:content';
const notes = await getCollection('notes');
const singles = await getCollection('singles');
---
<h1>debug: collections</h1>
<ul id="notes">
  {notes.map((n) => <li>{n.id} · {n.data.status} · {n.data.updated.toISOString().slice(0, 10)}</li>)}
</ul>
<ul id="singles">
  {singles.map((s) => <li>{s.id}</li>)}
</ul>
