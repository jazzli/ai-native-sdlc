---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const adopt = await getEntry('singles', 'docs/adopt');
if (!adopt) throw new Error('adopt singleton missing');
const { Content } = await render(adopt);
const base = import.meta.env.BASE_URL;
---

<Base
  title="Adopt"
  description="Adopt this playbook into a repository: two commands and no agent, or one line pasted at a coding agent."
  mdHref={`${base}/adopt.md`}
>
  <Content />
</Base>
