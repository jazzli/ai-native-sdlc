---
import Base from './Base.astro';
import { challengeUrl } from '../lib/challenge';
import { kindFor } from '../lib/note-route';
import fs from 'node:fs';
import { extractClaims } from '../lib/manifest';
import { CONTENT } from '../lib/site-config';
import type { CollectionEntry } from 'astro:content';
interface Props {
  note: CollectionEntry<'notes'>;
}
const { note } = Astro.props;
const { title, status, updated } = note.data;
const base = import.meta.env.BASE_URL;
const kind = kindFor(status);
// The note's title is the question it answers; its claim is what the page
// argues. A description repeating the title tells a search result nothing.
const claim = extractClaims(fs.readFileSync(CONTENT.playbookFile, 'utf8'))[
  note.id
];
const date = updated.toISOString().slice(0, 10);
const label = status.replace(/-/g, ' ');
const challenge = challengeUrl({
  title,
  slug: note.id,
  kind,
  status,
  updated: date,
});
---

<Base
  title={title}
  description={claim ?? title}
  ogType="article"
  mdHref={`${base}/${kind}/${note.id}.md`}
>
  <article class="note">
    <p class="meta">
      <span class={`badge ${status}`}>{label}</span>
      <time datetime={date}>updated {date}</time>
    </p>
    <h1>{title}</h1>
    <slot />
    <p class="challenge">
      Have evidence that bears on this?
      <a href={challenge} rel="noopener">Challenge this position</a> — it enters the
      same filter as every other source.
    </p>
  </article>
</Base>
