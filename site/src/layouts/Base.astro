---
import '../styles/global.css';
interface Props { title: string; description?: string; mdHref?: string }
const { title, description, mdHref } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · AI-Native SDLC</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <nav>
      <a href={`${base}/`}>Positions</a>
      <a href={`${base}/sources/`}>Sources</a>
      <a href={`${base}/protocol/`}>Protocol</a>
    </nav>
    <main><slot /></main>
    <footer>
      {mdHref && <a href={mdHref} class="md-link">View this page as markdown</a>}
    </footer>
  </body>
</html>
