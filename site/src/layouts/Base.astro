---
import '../styles/global.css';
import { SITE_ORIGIN } from '../lib/site-config';
import { ogSlug } from '../lib/og-slug';
interface Props {
  title: string;
  description?: string;
  mdHref?: string;
  variant?: string;
}
const { title, description, mdHref, variant } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
// Astro.url.pathname is already base-prefixed (e.g. "/ai-native-sdlc/sources/"),
// so the canonical URL is just the origin plus that — prepending SITE_BASE
// again would double it up.
const canonicalURL = `${SITE_ORIGIN}${path}`;
const ogCard = ogSlug(path, base);
const pageTitle = `${title} · AI-Native SDLC`;
// Inline SVG favicon — the falsifier's ink ground with the status marker at
// its centre. A data URI, so the page still makes no external request and the
// browser never falls back to /favicon.ico.
const favicon =
  "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20fill='%2315201e'/%3E%3Crect%20x='10'%20y='10'%20width='12'%20height='12'%20fill='%2374d6bf'/%3E%3C/svg%3E";
const on = (seg: string) =>
  path === `${base}/${seg}/` || path.startsWith(`${base}/${seg}/`);
const isPositions =
  path === `${base}/` || path === base || on('positions') || on('questions');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={favicon} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="AI-Native SDLC changelog"
      href={`${base}/changelog.xml`}
    />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {
      ogCard && (
        <>
          <meta
            property="og:image"
            content={`${SITE_ORIGIN}${base}/og/${ogCard}.png`}
          />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="wordmark" href={`${base}/`}>AI-Native SDLC</a>
      <nav aria-label="Sections">
        <a href={`${base}/`} aria-current={isPositions ? 'page' : undefined}
          >Positions</a
        >
        <a
          href={`${base}/sources/`}
          aria-current={on('sources') ? 'page' : undefined}>Sources</a
        >
        <a
          href={`${base}/protocol/`}
          aria-current={on('protocol') ? 'page' : undefined}>Protocol</a
        >
        <a
          href={`${base}/adopt/`}
          aria-current={on('adopt') ? 'page' : undefined}>Adopt</a
        >
        <a
          href={`${base}/changelog/`}
          aria-current={on('changelog') ? 'page' : undefined}>Changelog</a
        >
      </nav>
      <p class="strapline">Every position states what would overturn it.</p>
    </header>
    <main id="main" class={variant}><slot /></main>
    <footer>
      <a
        href={`${base}/colophon/`}
        class="md-link"
        aria-current={on('colophon') ? 'page' : undefined}
        >How this site is built</a
      >
      {
        mdHref && (
          <a href={mdHref} class="md-link">
            View this page as markdown
          </a>
        )
      }
    </footer>
  </body>
</html>
