{
  "name": "ai-native-sdlc-site",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "eslint . && eslint --config ../watch/eslint.config.js ../watch/discover.mjs ../watch/lib.mjs && eslint --config ../tools/eslint.config.js ../tools/assess.mjs ../tools/assess-host.mjs ../tools/check-policy.mjs",
    "format": "prettier --write . ../watch/discover.mjs ../watch/lib.mjs ../watch/watchlist.json '../tools/*.mjs'",
    "format:check": "prettier --check . ../watch/discover.mjs ../watch/lib.mjs ../watch/watchlist.json '../tools/*.mjs'",
    "test:coverage": "vitest run --coverage",
    "social-preview": "node --experimental-strip-types scripts/social-preview.ts",
    "check-policy": "node ../tools/check-policy.mjs",
    "assess": "node ../tools/assess.mjs",
    "assess-host": "node ../tools/assess-host.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.8",
    "github-slugger": "^2.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.47.1",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "^5.11.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "remark-smartypants": "3.0.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  }
}
